# The bundled examples through scan -> build -> audit -> query on the built
# binary: each stage reads what the previous one wrote, and graph.json and
# MAP.md match the goldens below (rewrite them with -update).
materialise $EXAMPLES repos
mkdir manifests out
exec myco scan --roots $WORK/repos --node demo --out manifests/demo.json
stderr 'orphan .*needs-sidecar'
exec myco build --manifests manifests --overlay $EXAMPLES/overlay.toml --dir out
normalise out/graph.json
cmp out/graph.json graph.golden.json
normalise out/MAP.md
cmp out/MAP.md map.golden.md

# needs-sidecar is an orphan; scratch is on the overlay's ignore list.
! exec myco audit --dir out
stdout 'needs-sidecar'
! stdout 'scratch'

# Using a capability is using its provider (2a2731b).
exec myco query used-by order-events --dir out
stdout 'billing-web'
exec myco query used-by orders-api --dir out
stdout 'billing-web'
exec myco query component shared-postgres --dir out
stdout 'shared-postgres'

# Input is never dropped silently.
exec myco query used-by --dir out order-events
stdout 'billing-web'
! exec myco query search a b --dir out
! exec myco scan --push http://127.0.0.1:1
stderr 'node'

